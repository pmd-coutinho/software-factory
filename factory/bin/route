#!/usr/bin/env python3
"""Assign the reviewer set from config.json to an accepted job.

Usage: route <job-id>

Each entry in config.json `reviewers` is either:
  - a string model name (e.g. "opus"), treated as always-on, or
  - {"model": "opus", "when": "always" | "surface:<name>"}

Records the selected agent set in job.json with `job agents`.
"""

import json
import subprocess
import sys
from pathlib import Path

FACTORY = Path(__file__).resolve().parents[1]
CONFIG = json.loads((FACTORY / "config.json").read_text())


def die(msg):
    print(f"route: {msg}", file=sys.stderr)
    sys.exit(1)


def select_reviewers(config_reviewers, surfaces):
    """Return (selected_dict, skipped_list) based on config rules and intake surfaces."""
    selected = {}
    skipped = []
    surface_set = set(surfaces or [])
    for name, spec in config_reviewers.items():
        if isinstance(spec, str):
            model, when = spec, "always"
        elif isinstance(spec, dict):
            model = spec.get("model")
            when = spec.get("when", "always")
        else:
            die(f"invalid reviewer config for {name!r}: {spec!r}")
        if not model:
            die(f"reviewer {name!r} is missing 'model'")
        if when == "always":
            selected[name] = model
        elif when.startswith("surface:"):
            req = when.split(":", 1)[1].strip()
            if req in surface_set:
                selected[name] = model
            else:
                skipped.append(f"{name} (no {req} surface)")
        else:
            die(f"unsupported reviewer condition {when!r} for {name!r}")
    if not selected:
        die("no reviewers selected; check factory/config.json `reviewers`")
    return selected, skipped


def main(argv):
    if len(argv) != 1:
        die("usage: route <job-id>")
    job_id = argv[0]
    job_bin = str(FACTORY / "bin" / "job")
    res = subprocess.run([job_bin, "sync", job_id], capture_output=True, text=True)
    if res.returncode != 0:
        die(res.stderr.strip())
    job = json.loads((FACTORY / "jobs" / job_id / "job.json").read_text())
    if not job["intake"]:
        die(f"{job_id} has no intake.md")
    reviewers, skipped = select_reviewers(CONFIG["reviewers"], job["intake"].get("surfaces", []))
    agents = {
        "reviewers": reviewers,
        "reviewer_effort": CONFIG.get("reviewer_effort", "high"),
    }
    res = subprocess.run([job_bin, "agents", job_id, json.dumps(agents)], capture_output=True, text=True)
    if res.returncode != 0:
        die(res.stderr.strip())
    effort = agents["reviewer_effort"]
    msg = f"{job_id}: reviewers " + ", ".join(f"{k} {v}({effort})" for k, v in reviewers.items())
    if skipped:
        msg += " | skipped: " + ", ".join(skipped)
    print(msg)


if __name__ == "__main__":
    main(sys.argv[1:])
